# Real Supabase mode: configure ALL three. Never expose the service key to a browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local/test only. When omitted and Supabase variables are absent, memory is used.
# GAME_REPOSITORY=memory
# ALLOW_IN_MEMORY=true
# HTTPS deployments default to secure cookies; false is for local HTTP only.
# COOKIE_SECURE=false
